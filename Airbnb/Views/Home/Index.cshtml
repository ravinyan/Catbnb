                        <img style="height: 100%; width: 100%" src="https://images.unsplash.com/photo-1548595224-8c7ae4e20bf6?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" />
                    </picture>
                </div>
            </a>
        </div>
        @*bottom info part*@
        <div style="display: grid">
            <div style="display: inline-flex; justify-content: space-between">
