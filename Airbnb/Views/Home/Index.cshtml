<div style="display: flex; justify-content: center; position: relative">
    <form>
        <div>
            @* buttons *@
            <div style="display: flex; align-items: center; justify-content: center">
                <button>stei</button>
                <button>exp</button>
            </div>
            @* form *@
            <div class="border rounded-pill shadow-sm" style="max-width: 850px; max-height: 66px; display: flex;">
                <div style=" display: flex; width: 100%">
                    @* WHERE *@
                    <div style="width: 33.33%">
                        <label style="width: 100%;">
                            <div style="padding: 9px 22px; font-size: 14px;">
                                <div style="font-weight: bold">
                                    Where
                                </div>
                                <input class="border-0" style="width: 100%; padding: 0 0 0 0; outline: none" placeholder="Search destinations" />
                            </div>
                        </label>
                    </div>
                    @* Check in/ Check out OR Date *@
                    <div style="width: 33.33%; display: flex">
                        <div style="width: 50%">
                            <label style="width: 100%; ">
                                <div style="padding: 9px 22px; font-size: 14px; width: 100%">
                                    <div style="font-weight: bold">
                                        Check in
                                    </div>
                                    <input class="border-0" style="width: 100%; padding: 0 0 0 0; outline: none; text-overflow: ellipsis" type="search" placeholder="Add dates" />
                                </div>
                            </label>
                        </div>
                        <div style="width: 50%">
                            <label style="width: 100%">
                                <div style="padding: 9px 22px; font-size: 14px">
                                    <div style="font-weight: bold; white-space:nowrap">
                                        Check out
                                    </div>
                                    <input class="border-0" style="width: 100%; padding: 0 0 0 0; outline: none; text-overflow: ellipsis" placeholder="Add dates" />
                                </div>
                            </label>
                        </div>
                    </div>
                    @* WHO *@
                    <div style="width: 33.33%; display: flex; align-items: center">
                        <label style="position:absolute">
                            <div style="padding: 9px 22px; font-size: 14px">
                                <div style="font-weight: bold;">
                                    Who
                                </div>
                                <input class="border-0" style="width: 100%; padding: 0 0 0 0; outline: none" placeholder="Add guests" />
                            </div>
                        </label>
                        <div style="width: 100%; align-content: center; text-align: right">
                            <button type="button" style="width: 48px; height: 48px; position: relative; background-color: #ff385c; border: none; color: white; border-radius: 26px; margin-inline-end: 8px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" class="bi bi-search" viewBox="0 1 16 16" style="background:none !important; stroke-width: 2; stroke:currentColor; overflow: visible;">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>



