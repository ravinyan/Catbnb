<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Airbnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Airbnb.styles.css" asp-append-version="true" />
</head>
<body>
    @* here will make fully top nav bar i guess *@
    <header class="border-bottom mb-3 header">
        <div id="TopHeader" class="border-bottom top_header">
            <div class="logo">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Airbnb</a>
            </div>
            <div id="StaysMenuButtons" class="stays_menu_buttons">
                <button type="button" class="btn button" onclick="displayStaysMenu()">Stays</button> 
                <button type="button" class="btn button" onclick="displayExperiencesMenu()">Experiences</button>
            </div>  
            <nav class="navbar navbar-expand navbar-light nav_bar_location">
                    <a class="navbar-brand" style="font-size: 14px" asp-area="" asp-controller="Home" asp-action="Index">Airbnb your home</a>
                    <button type="button" class="button rounded-circle border-0 bg-white">
                        <img src="/img/world-icon.png" style="width: 25px" />
                    </button>
                    <button type="button" class="btn button rounded-pill border align-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                           <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                        </svg>
                    </button>
            </nav>
        </div>
        <div>
            <div id="StaysMenuFormStays" class="btn-group border button_group stays_menu_buttons" role="search" style="top: 100px">
                <button type="button" class="btn button rounded-pill">Where</button>
                <button type="button" class="btn button rounded-pill" style="width: 188px">Date</button>
                <button type="button" class="btn button rounded-pill">Who</button>
                <button type="button" class="btn button rounded-circle" style="background-color: red">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </button>
            </div>
            <div id="StaysMenuFormExperiences" class="btn-group border button_group stays_menu_buttons" role="search" style="top: 100px; display: none;">
                <button type="button" class="btn button rounded-pill">Where</button>
                <button type="button" class="btn button rounded-pill">Check in</button>
                <button type="button" class="btn button rounded-pill">Check out</button>
                <button type="button" class="btn button rounded-pill">Who</button>
                <button type="button" class="btn button rounded-circle" style="background-color: red">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <button id="ScrollLeft" type="button" class="btn button rounded-circle border" style="outline: none; box-shadow: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-left" viewBox="0 0 16 16">
                    <path d="M10 12.796V3.204L4.519 8zm-.659.753-5.48-4.796a1 1 0 0 1 0-1.506l5.48-4.796A1 1 0 0 1 11 3.204v9.592a1 1 0 0 1-1.659.753" />
                </svg>
            </button>
            <div id="ScrollMenu" class="scrollmenu">
                <a href="#icons">Icons</a>
                <a href="#lakefront">Lakefront</a>
                <a href="#cabins">Cabins</a>
                <a href="#amazingviews">Amazing Views</a>
                <a href="#topoftheworld">Top of the world</a>
                <a href="#design">Design</a>
                <a href="#amazingpools">Amazing pools</a>
                <a href="#beachfront">Beachfront</a>
                <a href="#tinyhomes">Tiny homes</a>
                <a href="#countryside">Countryside</a>
                <a href="#omg">OMG!</a>
                <a href="#farms">Farms</a>
                <a href="#treehouses">Treehouses</a>
                <a href="#tropical">Tropical</a>
                <a href="#houseboats">Houseboats</a>
                <a href="#houseboats">Mansions</a>
                <a href="#houseboats">Boats</a>
                <a href="#houseboats">Domes</a>
                <a href="#houseboats">Off-the-grid</a>
                <a href="#houseboats">Camping</a>
                <a href="#houseboats">Rooms</a>
                <a href="#houseboats">National parks</a>
                <a href="#houseboats">Castles</a>
                <a href="#houseboats">Luxe</a>
                <a href="#houseboats">Vineyards</a>
                <a href="#houseboats">Islands</a>
                <a href="#houseboats">Top cities</a>
                <a href="#houseboats">Caves</a>
                <a href="#houseboats">Historical homes</a>
                <a href="#houseboats">Barns</a>
                <a href="#houseboats">Earth homes</a>
                <a href="#houseboats">Play</a>
                <a href="#houseboats">Containers</a>
                <a href="#houseboats">A-frames</a>
                <a href="#houseboats">Bed & breakfasts</a>
                <a href="#houseboats">New</a>
                <a href="#houseboats">Chef's kitchens'</a>
                <a href="#houseboats">Towers</a>
                <a href="#houseboats">ski-in/out</a>
                <a href="#houseboats">Creative spaces</a>
                <a href="#houseboats">Yurts</a>
                <a href="#houseboats">Arctic</a>
                <a href="#houseboats">Desert</a>
                <a href="#houseboats">Windmils</a>
                <a href="#houseboats">Trulli</a>
                <a href="#houseboats">Cycladic homes</a>
                <a href="#houseboats">Adapted</a>
                <a href="#houseboats">Casas particulares</a>
                <a href="#houseboats">Grand pianos</a>
                <a href="#houseboats">Dammusi</a>
                <a href="#houseboats">Riads</a>
                <a href="#houseboats">Skiing</a>
                <a href="#houseboats">Campers</a>
                <a href="#houseboats">Surfing</a>
                <a href="#houseboats">Golfing</a>
                <a href="#houseboats">Hanoks</a>
                <a href="#houseboats">Minsus</a>
                <a href="#houseboats">Ryokans</a>
                <a href="#houseboats">Shepherd's huts</a>
                <a href="#houseboats">Beach</a>
                <a href="#houseboats">Lake</a>
            </div>
            <button id="ScrollRight" type="button" class="btn button rounded-circle border" style="outline: none; box-shadow: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-right" viewBox="0 0 16 16">
                    <path d="M6 12.796V3.204L11.481 8zm.659.753 5.48-4.796a1 1 0 0 0 0-1.506L6.66 2.451C6.011 1.885 5 2.345 5 3.204v9.592a1 1 0 0 0 1.659.753" />
                </svg>
            </button>
            <button type="button" class="btn btn-danger filter">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-sliders" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M11.5 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M9.05 3a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0V3zM4.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M2.05 8a2.5 2.5 0 0 1 4.9 0H16v1H6.95a2.5 2.5 0 0 1-4.9 0H0V8zm9.45 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m-2.45 1a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0v-1z" />
                </svg>
                <span> Filters </span>
            </button>
        </div>
    </header>
    <div style="padding-inline-start: 30px; padding-top: 25px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
           &copy; footar ------------------------------------------- language setting / country currency (universal currency name?)
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
