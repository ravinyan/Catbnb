<!DOCTYPE html>
<html lang="en" id="LOGO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Airbnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Airbnb.styles.css" asp-append-version="true" />
</head>
<body>
    <div style="position: sticky; top: 0px; width: 100%; height: 262px; z-index: 100">
        <header id="heder" class="border-bottom header">
            <div id="TopHeader" style="height: 161px; transition: 0.2s">
                <div class="header_div">
                    @* scuffed airbnb logo *@
                    <div class="logo stretch">
                        <a class="text-decoration-none" style="font-size: 20px" asp-area="" asp-controller="Home" asp-action="Index"> <img id="Logo" src="/img/Joel.gif" width="100px" height="50px" /> </a>
                    </div>
                    @* buttons + mini form *@
                    <div style="display: flex; justify-content: center; align-items:center ; transition: 0.2s; padding-inline-start: 20px; padding-inline-end: 20px; text-align: center; min-width: 372px; min-height: 50px">
                        @* stays/experiences buttons *@
                        <div id="StaysMenuButtons" class="shadowe">
                            <button id="StaysMenuButton" type="button" class="btn button" style="border-radius: 50px; text-shadow: 0px 0px 1px black">Stays</button>
                            <button id="ExperiencesMenuButton" type="button" class="btn button" style="border-radius:50px">Experiences</button>
                        </div>
                        @* mini form *@
                        <div id="MiniForm" class="border shadow-sm text-nowrap" style="border-radius: 50px; display: none; height: 50px; min-width: 350px; align-items: center ; justify-content: center">
                            <button id="MiniAnywhereButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%">
                                <div class="fw-bold" style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                    Anywhere
                                </div>
                            </button>
                            <button id="MiniAnyWeekButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%">
                                <div class="fw-bold" style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                    Any week
                                </div>
                            </button>
                            <div class="d-inline-flex align-items-center" style="border-radius: 50px; height: 100%">
                                <button id="MiniAddGuestsButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%;">
                                    <div style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                       Add guests
                                    </div>
                                </button>
                                <div style="background-color: #ff385c; border-radius: 24px; width: 32px; height: 32px; color: white">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" class="bi bi-search search_icon" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                    @* nav bar (airbnb your home / world icon / login button) *@
                    <div class="stretch">
                        <nav class="navbar navbar-light header_navbar">
                            <div class="shadowe">
                                <a class="text-decoration-none href_button" style="color: black" asp-area="" asp-controller="Home" asp-action="Index">Airbnb your home</a>
                            </div>
                            <div class="shadowe">
                                <button id="GlobeIcon" type="button" class="btn button globe_button" data-bs-toggle="modal" data-bs-target="#ModalSettings">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-globe" viewBox="0 0 16 16">
                                        <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855A8 8 0 0 0 5.145 4H7.5zM4.09 4a9.3 9.3 0 0 1 .64-1.539 7 7 0 0 1 .597-.933A7.03 7.03 0 0 0 2.255 4zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a7 7 0 0 0-.656 2.5zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5zM8.5 5v2.5h2.99a12.5 12.5 0 0 0-.337-2.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5zM5.145 12q.208.58.468 1.068c.552 1.035 1.218 1.65 1.887 1.855V12zm.182 2.472a7 7 0 0 1-.597-.933A9.3 9.3 0 0 1 4.09 12H2.255a7 7 0 0 0 3.072 2.472M3.82 11a13.7 13.7 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5zm6.853 3.472A7 7 0 0 0 13.745 12H11.91a9.3 9.3 0 0 1-.64 1.539 7 7 0 0 1-.597.933M8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855q.26-.487.468-1.068zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.7 13.7 0 0 1-.312 2.5m2.802-3.5a7 7 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7 7 0 0 0-3.072-2.472c.218.284.418.598.597.933M10.855 4a8 8 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4z" />
                                    </svg>
                                </button>
                            </div>
                            <div class="nav_bar_shadow">
                                <button id="LoginButton" type="button" class="btn btn button rounded-pill border align-items-center d-inline-flex" style="">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-list" viewBox="4 0 16 16" style="outline: none; box-shadow:none">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                                    </svg>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16" style="outline: none; box-shadow:none">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                    </svg>
                                </button>
                            </div>
                        </nav>
                    </div>
                </div>
                @* FORMS *@
                <div id="StaysMenuForm">
                    <form class="form">
                        <div class="justify-content-center d-flex position-relative" style="width: 850px">
                            @* form *@
                            <div class="border shadow-sm form_border d-inline-flex">
                                <div class="form_container">
                                    @* WHERE *@
                                    <div style="width: 33.33%; border-radius: 50px">
                                        <label class="shadowe w-100" style="border-radius: 50px;">
                                            <div id="WhereButton" class="label_box">
                                                <div class="fw-bold" style="background: none">
                                                    Where
                                                </div>
                                                <input class="border-0 input" placeholder="Search destinations" value="" spellcheck="false"/>
                                            </div>
                                        </label>
                                        @* popup modal thingy *@
                                        <div id="WhereDropdown" class="shadow dropdown_window" style="left: 0px; min-width: 50%;">
                                            <div class="dropdown_window_header">Search by region</div>
                                            <div class="dropdown_window_grid shadowe">
                                                <div class="region_box" >
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box"  src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        I'm flexible
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Southeast Asia
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Spain
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Middle East
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Italy
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        United states
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="border-right: 1px solid #ebebeb; height: 30px; align-self: center"></div>
                                    @* Check in/ Check out *@
                                    <div style="width: 33.33%; display: flex; background: none">
                                        <div style="width: 50%">
                                            <label class="shadowe w-100">
                                                <div id="CheckinButton" class="label_box">
                                                    <div class="fw-bold text-nowrap" style="background: none">
                                                        Check in
                                                    </div>
                                                    <input id="CheckinInput" class="border-0 input" type="search" placeholder="Add dates" value="" spellcheck="false" readonly />
                                                </div>
                                            </label>
                                            @* popup modal thingy *@
                                            <div id="CheckinDropdown" class="shadow dropdown_window" style="width: 100%; left: 0px">
                                                <div style="display: flex; justify-content: center">
                                                    <div style="background-color: #dedede; justify-content: center; display: flex; border-radius: 50px; align-items: center">
                                                        <div class="shadowe">
                                                            <button id="DatesButton" type="button" class="btn" style="border-radius: 50px; margin: 5px; background-color: white">
                                                                Dates
                                                            </button>
                                                        </div>
                                                        <div class="shadowe">
                                                            <button id="MonthsButton" type="button" class="btn" style="border-radius: 50px; margin-block-start: 5px; margin-block-end: 5px;">
                                                                Months
                                                            </button>
                                                        </div>
                                                        <div class="shadowe">
                                                            <button id="FlexibleButton" type="button" class="btn" style="border-radius: 50px; margin: 5px;">
                                                                Flexible
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                @* WHERE DO I PUT THE DAYS OF THE WEEK AAAAAAAAAAAAA *@
                                                <div class="shadowe" style="width: 100%; height: 0px">
                                                    <button id="MoveCalendarsLeft" type="button" class="btn" style="position: absolute; left: 0">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-left" viewBox="0 3 16 16">
                                                            <path d="M10 12.796V3.204L4.519 8zm-.659.753-5.48-4.796a1 1 0 0 1 0-1.506l5.48-4.796A1 1 0 0 1 11 3.204v9.592a1 1 0 0 1-1.659.753" />
                                                        </svg>
                                                    </button>
                                                    <button id="MoveCalendarsRight" type="button" class="btn" style="position: absolute; right: 0">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-right" viewBox="0 3 16 16">
                                                            <path d="M6 12.796V3.204L11.481 8zm.659.753 5.48-4.796a1 1 0 0 0 0-1.506L6.66 2.451C6.011 1.885 5 2.345 5 3.204v9.592a1 1 0 0 0 1.659.753" />
                                                        </svg>
                                                    </button>
                                                </div>
                                                <div style="display: flex; width: 100%">
                                                    <div id="Calendar" style="width: 50%; padding: 20px">
                                                        <ul class="days_list">
                                                            @* day of the week starts from monday and I DONT CARE CRY ABOUT IT *@
                                                            <li class="box">Mon</li>
                                                            <li class="box">Tue</li>
                                                            <li class="box">Wed</li>
                                                            <li class="box">Thu</li>
                                                            <li class="box">Fri</li>
                                                            <li class="box">Sat</li>
                                                            <li class="box">Sun</li>
                                                        </ul>
                                                    </div>
                                                    <div id="Calendar2" style="width: 50%; padding: 20px">
                                                        <ul class="days_list">
                                                            @* day of the week starts from monday and I DONT CARE CRY ABOUT IT *@
                                                            <li class="box">Mon</li>
                                                            <li class="box">Tue</li>
                                                            <li class="box">Wed</li>
                                                            <li class="box">Thu</li>
                                                            <li class="box">Fri</li>
                                                            <li class="box">Sat</li>
                                                            <li class="box">Sun</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="shadowe">
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            Exact dates
                                                        </button>
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            +- 1 day
                                                        </button>
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            +- 2 days
                                                        </button>
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            +- 3 days
                                                        </button>
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            +- 7 days
                                                        </button>
                                                        <button type="button" class="btn" style="border-radius: 50px">
                                                            +- 14 days
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="border-right: 1px solid #ebebeb; height: 30px; align-self: center"></div>
                                        <div style="width: 50%">
                                            <label class="shadowe w-100">
                                                <div id="CheckoutButton" class="label_box">
                                                    <div class="fw-bold text-nowrap" style="background: none">
                                                        Check out
                                                    </div>
                                                    <input id="CheckoutInput" class="border-0 input" type="search" placeholder="Add dates" value="" spellcheck="false" readonly />
                                                </div>
                                            </label>
                                            @* popup modal thingy *@
                                            
                                        </div>    
                                    </div>
                                    @* WHO *@
                                    <div style="border-right: 1px solid #ebebeb; height: 30px; align-self: center"></div>
                                    <div style="width: 33.3%; border-radius: 50px">
                                        <div class=" d-flex w-100" style="border-radius: 50px">
                                            <div id="WhoButton" class="who_container">
                                                <label style="background:none; width: 100%; border-radius: 50px;">
                                                    <div class="label_box" style="background: none">
                                                        <div class="fw-bold" style="background: none">
                                                            Who
                                                        </div>
                                                        <input id="GuestsInput" class="border-0 input"  type="search" placeholder="Add guests" value="" spellcheck="false" readonly />
                                                    </div>
                                                </label>
                                            </div>
                                            <div class="search_button_box" style="background: none">
                                                <button id="SearchButton" type="button" class="search_button" style="z-index: 727">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" class="bi bi-search search_icon" viewBox="0 1 16 16">
                                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                        @* popup modal thingy *@
                                        <div id="WhoDropdown" class="shadow dropdown_window test" style="right: 0px; min-width: 50%;">
                                            <div>
                                                <div class="guest_box">
                                                    <section>
                                                        <div style="font-weight: bold">
                                                            Adults
                                                        </div>
                                                        <div style="font-size: 14px; font-weight: 200; padding-block-start: 4px">
                                                            Ages 13 or above
                                                        </div>
                                                    </section>
                                                    <div style="width: 100px; display: flex; justify-items: center; justify-content: space-between">
                                                        <button id="DecreaseAdultCount" type="button" class="guest_button_decrease" style="cursor: not-allowed;">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash border-0" viewBox="0 0 16 16">
                                                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                            </svg>
                                                        </button>
                                                        <div id="AdultsCount"> 0 </div>
                                                        <button id="IncreaseAdultCount" type="button" class="guest_button_increase guest_button_color " style="cursor: pointer">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus border-0" viewBox="0 0 16 16">
                                                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                                            </svg>
                                                        </button> 
                                                    </div>
                                                </div>
                                                <div class="guest_box">
                                                    <section>
                                                        <div style="font-weight: bold">
                                                        Children
                                                        </div>
                                                        <div style="font-size: 14px; font-weight: 200; padding-block-start: 4px">
                                                            Ages 2 - 12
                                                        </div>
                                                    </section>
                                                    <div style="width: 100px; display: flex; justify-items: center; justify-content: space-between">
                                                        <button id="DecreaseChildCount" type="button" class="guest_button_decrease" style="cursor: not-allowed;">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash border-0" viewBox="0 0 16 16">
                                                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                            </svg>
                                                        </button>
                                                        <div id="ChildrenCount"> 0 </div>
                                                        <button id="IncreaseChildCount" type="button" class="guest_button_increase guest_button_color" style="cursor: pointer">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus border-0" viewBox="0 0 16 16">
                                                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="guest_box">
                                                    <section>
                                                        <div style="font-weight: bold">
                                                            Infants
                                                        </div>
                                                        <div style="font-size: 14px; font-weight: 200; padding-block-start: 4px">
                                                            Under 2
                                                        </div>
                                                    </section>
                                                    <div style="width: 100px; display: flex; justify-items: center; justify-content: space-between">
                                                        <button id="DecreaseInfantCount" type="button" class="guest_button_decrease" style="cursor: not-allowed;">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash border-0" viewBox="0 0 16 16">
                                                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                            </svg>
                                                        </button>
                                                        <div id="InfantsCount"> 0 </div>
                                                        <button id="IncreaseInfantCount" type="button" class="guest_button_increase guest_button_color" style="cursor: pointer">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus border-0" viewBox="0 0 16 16">
                                                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="guest_box">
                                                    <section>
                                                        <div style="font-weight: bold">
                                                            Pets
                                                        </div>
                                                        <button type="button" class="border-0" style="background: none; padding: 0px; text-decoration: underline; font-size: 14px; padding-block-start: 4px">
                                                            Bringing a service animal?
                                                        </button>
                                                    </section>
                                                    <div style="width: 100px; display: flex; justify-items: center; justify-content: space-between">
                                                        <button id="DecreasePetCount" type="button" class="guest_button_decrease" style="cursor: not-allowed;">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash border-0" viewBox="0 0 16 16">
                                                                <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                            </svg>
                                                        </button>
                                                        <div id="PetsCount"> 0 </div>
                                                        <button id="IncreasePetCount" type="button" class="guest_button_increase guest_button_color" style="cursor: pointer">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus border-0" viewBox="0 0 16 16">
                                                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div id="ExperiencesMenuForm" style="display: none">
                    <form class="form">
                        <div class="justify-content-center d-flex" style="width: 850px">
                            @* form *@
