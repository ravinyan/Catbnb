<!DOCTYPE html>
<html lang="en" id="LOGO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Airbnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Airbnb.styles.css" asp-append-version="true" />
</head>
<body>
    <div style="position: sticky; top: 0px; width: 100%; height: 262px; z-index: 100">
        <header id="heder" class="border-bottom header">
            <div id="TopHeader" style="height: 161px; transition: 0.2s">
                <div class="header_div">
                    @* scuffed airbnb logo *@
                    <div class="logo stretch">
                        <a class="text-decoration-none" style="font-size: 20px" asp-area="" asp-controller="Home" asp-action="Index"> <img id="Logo" src="/img/Joel.gif" width="100px" height="50px" /> </a>
                    </div>
                    @* buttons + mini form *@
                    <div style="display: flex; justify-content: center; align-items:center ; transition: 0.2s; padding-inline-start: 20px; padding-inline-end: 20px; text-align: center; min-width: 372px; min-height: 50px">
                        @* stays/experiences buttons *@
                        <div id="StaysMenuButtons" class="shadowe">
                            <button id="StaysMenuButton" type="button" class="btn button" style="border-radius: 50px; text-shadow: 0px 0px 1px black">Stays</button>
                            <button id="ExperiencesMenuButton" type="button" class="btn button" style="border-radius:50px">Experiences</button>
                        </div>
                        @* mini form *@
                        <div id="MiniForm" class="border shadow-sm text-nowrap" style="border-radius: 50px; display: none; height: 50px; min-width: 350px; align-items: center ; justify-content: center">
                            <button id="MiniAnywhereButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%">
                                <div class="fw-bold" style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                    Anywhere
                                </div>
                            </button>
                            <button id="MiniAnyWeekButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%">
                                <div class="fw-bold" style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                    Any week
                                </div>
                            </button>
                            <div class="d-inline-flex align-items-center" style="border-radius: 50px; height: 100%">
                                <button id="MiniAddGuestsButton" type="button" class="btn button text-nowrap p-0" style="font-size: 14px; height: 100%;">
                                    <div style="padding-inline-start: 15px; padding-inline-end: 15px; text-overflow: ellipsis">
                                       Add guests
                                    </div>
                                </button>
                                <div style="background-color: #ff385c; border-radius: 24px; width: 32px; height: 32px; color: white">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" class="bi bi-search search_icon" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                    @* nav bar (airbnb your home / world icon / login button) *@
                    <div class="stretch">
                        <nav class="navbar navbar-light header_navbar">
                            <div class="shadowe">
                                <a class="text-decoration-none href_button" style="color: black" asp-area="" asp-controller="Home" asp-action="Index">Airbnb your home</a>
                            </div>
                            <div class="shadowe">
                                <button id="GlobeIcon" type="button" class="btn button globe_button">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-globe" viewBox="0 0 16 16">
                                        <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855A8 8 0 0 0 5.145 4H7.5zM4.09 4a9.3 9.3 0 0 1 .64-1.539 7 7 0 0 1 .597-.933A7.03 7.03 0 0 0 2.255 4zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a7 7 0 0 0-.656 2.5zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5zM8.5 5v2.5h2.99a12.5 12.5 0 0 0-.337-2.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5zM5.145 12q.208.58.468 1.068c.552 1.035 1.218 1.65 1.887 1.855V12zm.182 2.472a7 7 0 0 1-.597-.933A9.3 9.3 0 0 1 4.09 12H2.255a7 7 0 0 0 3.072 2.472M3.82 11a13.7 13.7 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5zm6.853 3.472A7 7 0 0 0 13.745 12H11.91a9.3 9.3 0 0 1-.64 1.539 7 7 0 0 1-.597.933M8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855q.26-.487.468-1.068zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.7 13.7 0 0 1-.312 2.5m2.802-3.5a7 7 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7 7 0 0 0-3.072-2.472c.218.284.418.598.597.933M10.855 4a8 8 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4z" />
                                    </svg>
                                </button>
                            </div>
                            <div class="nav_bar_shadow">
                                <button id="UserMenuDropdownButton" type="button" class="btn btn button rounded-pill border align-items-center d-inline-flex" style="">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-list" viewBox="4 0 16 16" style="outline: none; box-shadow:none">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                                    </svg>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16" style="outline: none; box-shadow:none">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                                    </svg>
                                </button>
                                
                            </div>
                            <div id="UserMenuDropdown" class="shadow-lg shadowe" style="display: none; position: absolute; top: 100%; height: 300px; width: 200px; border-radius: 15px; z-index: 728; background: white">
                                <button id="SignUpButton" class="login_dropdown_button" style="font-weight: 600; margin-block-start: 10px;">
                                    Sign up
                                </button>
                                <button id="LogInButton" class="login_dropdown_button">
                                    Log in
                                </button>
                                <button id="GiftCardsButton" class="login_dropdown_button" style="border-top: 1px solid #ebebeb">
                                    Gift cards
                                </button>
                                <button id="AirbnbYourHomeButton" class="login_dropdown_button">
                                    Airbnb your home
                                </button>
                                <button id="HostAnExperienceButton" class="login_dropdown_button">
                                    Host an experience
                                </button>
                                <button id="HelpCenterButton" class="login_dropdown_button">
                                    Help center
                                </button>
                            </div>
                        </nav>
                    </div>
                </div>
                @* FORMS *@
                <div id="StaysMenuForm">
                    <form class="form">
                        <div class="justify-content-center d-flex position-relative" style="width: 850px">
                            @* form *@
                            <div class="border shadow-sm form_border d-inline-flex">
                                <div class="form_container">
                                    @* WHERE *@
                                    <div style="width: 33.33%; border-radius: 50px">
                                        <label class="shadowe w-100" style="border-radius: 50px;">
                                            <div id="WhereButton" class="label_box">
                                                <div class="fw-bold" style="background: none">
                                                    Where
                                                </div>
                                                <input class="border-0 input" placeholder="Search destinations" value="" spellcheck="false"/>
                                            </div>
                                        </label>
                                        @* popup modal thingy *@
                                        <div id="WhereDropdown" class="shadow dropdown_window" style="left: 0px; min-width: 50%;">
                                            <div class="dropdown_window_header">Search by region</div>
                                            <div class="dropdown_window_grid shadowe">
                                                <div class="region_box" >
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box"  src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        I'm flexible
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Southeast Asia
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Spain
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Middle East
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        Italy
                                                    </div>
                                                </div>
                                                <div class="region_box">
                                                    <button type="button" class="p-0 border-0 w-100" style="background: none">
                                                        <img class="image_box" src="~/img/red-square.png" />
                                                    </button>
                                                    <div>
                                                        United states
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="border-right: 1px solid #ebebeb; height: 30px; align-self: center"></div>
                                    @* WHEN MONTHS BLOCK*@
                                    <div id="WhenFormMenu" style="width: 33.33%; display: flex; background: none; display: none">
                                        <label class="shadowe w-100">
                                            <div id="WhenButton" class="label_box">
                                                <div class="fw-bold text-nowrap" style="background: none">
                                                    When
                                                </div>
                                                <div id="MonthsBlockWhenInput" class="border-0 input" readonly></div>
                                            </div>
                                        </label>
                                    </div>
                                    @* WHEN FLEXIBLE BLOCK*@
                                    <div id="FlexibleBlockWhenFormMenu" style="width: 33.33%; display: flex; background: none; display: none">
                                        <label class="shadowe w-100">
                                            <div id="FlexibleBlockWhenButton" class="label_box">
                                                <div class="fw-bold text-nowrap" style="background: none">
                                                    When
                                                </div>
                                                <div id="FlexibleBlockWhenInput" class="border-0 input" readonly></div>
                                            </div>
                                        </label>
                                    </div>
                                    @* CHECK IN/ CHECK OUT *@
                                    <div id="CheckinFormMenu" style="width: 33.33%; display: flex; background: none;">
                                        <div style="width: 50%">
                                            <label class="shadowe w-100">
                                                <div id="CheckinButton" class="label_box">
                                                    <div class="fw-bold text-nowrap" style="background: none">
                                                        Check in
                                                    </div>
                                                    <input id="CheckinInput" class="border-0 input" type="search" placeholder="Add dates" value="" spellcheck="false" readonly />
                                                </div>
                                            </label>
                                            @* popup modal thingy *@
                                        </div>
                                        <div style="border-right: 1px solid #ebebeb; height: 30px; align-self: center"></div>
                                        <div style="width: 50%; display: inline-block">
                                            <label class="shadowe w-100">
                                                <div id="CheckoutButton" class="label_box">
                                                    <div class="fw-bold text-nowrap" style="background: none">
                                                        Check out
                                                        
                                                    </div>
                                                    <input id="CheckoutInput" class="border-0 input" type="search" placeholder="Add dates" value="" spellcheck="false" readonly />
                                                </div>
                                            </label>
                                            <div style="position: absolute;">
                                                <button id="ClearCalendarFormInputsButton" type="button" class="resetDatesForm">
                                                    <svg id="ClearCalendarFormInputsButtonSVG" xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-x shadoweP" viewBox="0 0 16 16" style="border-radius: 50px">
                                                        <path id="ClearCalendarFormInputsButtonPATH" d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" style="z-index: -1" />
                                                    </svg>
                                                </button>
                                            </div>
                                            @* popup modal thingy *@                       
                                        </div>    
                                    </div>
                                    @* DATES DROPDOWN *@
                                    <div id="CheckinDropdown" class="shadow dropdown_window" style="width: 100%; left: 0px">
                                        <div style="display: flex; justify-content: center">
                                            <div style="background-color: #dedede; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; border-radius: 50px; width: 300px; height: 46px;">
                                                <button id="DatesButton" type="button" class="btn shadoweP" style="border-radius: 50px; margin: 4px 4px; background-color: white">
                                                    Dates
                                                </button>
                                                <button id="MonthsButton" type="button" class="btn shadoweP" style="border-radius: 50px; margin: 4px 0px; ">
                                                    Months
                                                </button>
                                                <button id="FlexibleButton" type="button" class="btn shadoweP" style="border-radius: 50px; margin: 4px 4px;">
                                                    Flexible
                                                </button>
                                            </div>
                                        </div>
                                        @* dates block *@
                                        <div id="DatesBlock" style="display: block">
                                            <div class="shadowe" style="width: 100%; height: 0px">
                                                <button id="MoveCalendarsLeft" type="button" class="btn" style="position: absolute; left: 0; border-radius: 50px; cursor: not-allowed; color: #dcdcdc; background: none; margin-inline-start: 30px">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-left-fill" style="background: none;" viewBox="0 3 16 16">
                                                        <path d="m3.86 8.753 5.482 4.796c.646.566 1.658.106 1.658-.753V3.204a1 1 0 0 0-1.659-.753l-5.48 4.796a1 1 0 0 0 0 1.506z" />
                                                    </svg>
                                                </button>
                                                <button id="MoveCalendarsRight" type="button" class="btn" style="position: absolute; right: 0; border-radius: 50px; cursor: pointer; margin-inline-end: 30px">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-right-fill" style="background: none;" viewBox="0 3 16 16">
                                                        <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z" />
                                                    </svg>
                                                </button>
                                            </div>
                                            <div id="DatesCalendars" class="calendars">
                                                <div id="Calendar" style="max-width: 375px; padding: 10px">
                                                    <ul class="days_list">
                                                        @* day of the week starts from monday and I DONT CARE CRY ABOUT IT *@
                                                        <li class="box">Mon</li>
                                                        <li class="box">Tue</li>
                                                        <li class="box">Wed</li>
                                                        <li class="box">Thu</li>
                                                        <li class="box">Fri</li>
                                                        <li class="box">Sat</li>
                                                        <li class="box">Sun</li>
                                                    </ul>
                                                </div>
                                                <div id="Calendar2" style="max-width: 375px; padding: 10px">
                                                    <ul class="days_list">
                                                        @* day of the week starts from monday and I DONT CARE CRY ABOUT IT *@
                                                        <li class="box">Mon</li>
                                                        <li class="box">Tue</li>
                                                        <li class="box">Wed</li>
                                                        <li class="box">Thu</li>
                                                        <li class="box">Fri</li>
                                                        <li class="box">Sat</li>
                                                        <li class="box">Sun</li>
                                                    </ul>
                                                </div>
                                            </div>
                                            <div>
                                                <div style="margin-block-start: 10px; display:flex; align-items: center; gap: 10px">
                                                    <button id="CalendarExactDatesButton" type="button" class="PM">
                                                        Exact dates
                                                    </button>
                                                    <button id="CalendarPM1Button" type="button" class="PM">
                                                        ± 1 day
                                                    </button>
                                                    <button id="CalendarPM2Button" type="button" class="PM">
                                                        ± 2 days
                                                    </button>
                                                    <button id="CalendarPM3Button" type="button" class="PM">
                                                        ± 3 days
                                                    </button>
                                                    <button id="CalendarPM7Button" type="button" class="PM">
                                                        ± 7 days
                                                    </button>
                                                    <button id="CalendarPM14Button" type="button" class="PM">
                                                        ± 14 days
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        @* months block *@
                                        <div id="MonthsBlock" style="display: none">
                                            <div>
                                                <div class="months_block_header">
                                                    When's your trip?
                                                </div>
                                                <div style="display: flex; justify-content: center; align-items: center;">
                                                    <div class="months_block_BigScaryCircle">
                                                        <div id="MonthsBlockMonthNumber" style="font-size: 50px; display: flex; justify-content: center; align-items: center; text-align: center; top: 100px; left: 100px; max-width: 150px; min-width: 150px; position: absolute">
                                                            3 Months
                                                        </div>
                                                        <div id="MonthsDot1" style="left: 232.5px; top: 34.4263px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot2" style="left: 285.5736px; top: 87.5px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot3" style="left: 305px; top: 160px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot4" style="left: 285.5736px; top: 232.5px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot5" style="left: 232.5px; top: 285.5736px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot6" style="left: 160px; top: 305px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot7" style="left: 87.5px; top: 285.5736px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot8" style="left: 34.4263px; top: 232.5px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot9" style="left: 15px; top: 160px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot10" style="left: 34.4263px; top: 87.5px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot11" style="left: 87.5px; top: 34.4263px" class="months_circle_dot">O</div>
                                                        <div id="MonthsDot12" style="left: 160px; top: 15px" class="months_circle_dot">O</div>
                                                        @*click the circles to beat*@
                                                        <svg id="MonthsBlockCircleSVG" style="height: 350px; width: 350px;" xmlns="http://www.w3.org/2000/svg">
                                                            <circle id="MonthsBlockCircle" r="145" cx="50%" cy="50%" fill="none"></circle>
                                                            <circle id="MonthsBlockDraggableCircle" r="30" cx="320" cy="50%" fill="red" cursor="grab"></circle>
                                                        </svg>
                                                    </div>
                                                </div>
                                                <div class="months_block_footer">
                                                    <div>
                                                        <button id="MonthsBlockWhenStartDate" type="button" class="when_buttons">

                                                        </button>
                                                    </div>
                                                    <div style="padding: 0 5px;">to</div>
                                                    <div>
                                                        <button id="MonthsBlockWhenEndDate" type="button" class="when_buttons">

                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @* flexible block *@
                                        <div id="FlexibleBlock" style="display: none">
                                            <div style="display: grid; padding-block-start: 30px; row-gap: 30px;">
                                                <div style="">
                                                    <div id="FlexibleBlockStay" style="display: flex; justify-content: center; font-size: 20px; font-weight: 600; padding: 15px 0px">
                                                        Stay forever
                                                    </div>
                                                    <div style="display: flex; justify-content: center; column-gap: 10px; height: 40px;">
                                                        <button id="FlexibleBlockWeekendButton" type="button" class="stay_button">
                                                            Weekend
                                                        </button>
                                                        <button id="FlexibleBlockWeekButton" type="button" class="stay_button">
                                                            Week
                                                        </button>
                                                        <button id="FlexibleBlockMonthButton" type="button" class="stay_button">
                                                            Month
                                                        </button>
                                                    </div>
                                                </div>
                                                <div style="overflow: hidden">
                                                    <div id="FlexibleBlockGo" style="display: flex; width: 100%; justify-content: center; font-size: 20px; font-weight: 600">
                                                        Go go power rangers... ?
                                                    </div>
                                                    <div id="FlexibleBlockMonthCardMenu" class="card_menu">
                                                        @*auto generated stuff go!*@
                                                        <div style="z-index: 1; position: absolute; display: flex; align-content: center; left: 7px;">
                                                            <button id="FlexbibleBlockMonthCardMenuLeftButton" type="button" class="month_card_left_button">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-left" viewBox="0 0 16 16">
                                                                    <path d="M10 12.796V3.204L4.519 8zm-.659.753-5.48-4.796a1 1 0 0 1 0-1.506l5.48-4.796A1 1 0 0 1 11 3.204v9.592a1 1 0 0 1-1.659.753" />
                                                                </svg>
                                                            </button>
                                                        </div>
                                                        <div style="z-index: 1; position: absolute; display: flex; align-content: center; right: 9px;">
                                                            <button id="FlexbibleBlockMonthCardMenuRightButton" type="button" class="month_card_right_button">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-caret-right" viewBox="0 0 16 16">
