@{
    ViewData["Title"] = "Bone Page";
}

<div id="RoomContent" class="room">
    <div class="room_header">
        <div class="room_header_topText">
            Cozy house on the water for 6 people
        </div>
        <div class="room_header_buttons">
            <button class="room_header_share_box">
                <svg viewBox="0 -3 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false" style="display: block; fill: none; height: 16px; width: 16px; stroke: currentcolor; stroke-width: 2; overflow: visible; margin-inline-end: 8px;">
                    <path d="m27 18v9c0 1.1046-.8954 2-2 2h-18c-1.10457 0-2-.8954-2-2v-9m11-15v21m-10-11 9.2929-9.29289c.3905-.39053 1.0237-.39053 1.4142 0l9.2929 9.29289" fill="none"></path>
                </svg>
                Share
            </button>
            <button class="room_header_save_box">
                <svg viewBox="0 -3 32 32" xmlns="http://www.w3.org/2000/svg" focusable="false" style="display: block; fill: none; height: 16px; width: 16px; stroke: currentcolor; stroke-width: 2; overflow: visible; margin-inline-end: 8px;">
                    <path d="M16 28c7-4.73 14-10 14-17a6.98 6.98 0 0 0-7-7c-1.8 0-3.58.68-4.95 2.05L16 8.1l-2.05-2.05a6.98 6.98 0 0 0-9.9 0A6.98 6.98 0 0 0 2 11c0 7 7 12.27 14 17z"></path>
                </svg>
                Save
            </button>
        </div>
    </div>
    <div class="room_images">
        <div class="room_images_mainImage">
            <div class="room_images_image_box">
                <img class="room_images_image" src="~/img/img5.png" />
            </div>
        </div>
        <div class="room_images_sideImages">
            <div class="room_images_side1">
                <div class="room_images_image_box">
                    <img class="room_images_image" src="~/img/img1.png" />
                </div>
                <div class="room_images_image_box">
                    <img class="room_images_image" src="~/img/img2.png" />
                </div>
            </div>
            <div class="room_images_side2">
                <div class="room_images_image_box">
                    <img class="room_images_image" src="~/img/img3.png" />
                </div>
                <div class="room_images_image_box">
                    <img class="room_images_image" src="~/img/img4.png" />
                </div>
            </div>
        </div>
    </div>
    <div class="room_information_section">
        <div class="room_information">
            <div class="room_information_header">
                <div class="room_information_stay_box">
                    <div class="room_information_stay_location">
                        Entire home in Cymbark, Poland
                    </div>
                    <div class="room_information_stay_living">
                        6 guests - 2 bedrooms - 3 beds - 1 bath
                    </div>
                </div>
                <div class="room_information_reviews">
                    <div>
                        guest favobla
                    </div>
                    <div>
                        bla bla *
                    </div>
                    <div>
                        bla aaaaa
                    </div>
                </div>
                <div class="room_information_host">
                    <div class="room_information_host_pfp">
                        •⩊•
                    </div>
                    <div>
                        <div class="room_information_host_name">
                            Hosted by your cat
                        </div>
                        <div class="room_information_host_description">
                            Super Scratcher - 3 couches destroyed
                        </div>
                    </div>
                </div>
            </div>
            <div class="room_information_benefits">

            </div>
            <div class="room_information_description">

            </div>
            <div class="room_information_petting">

            </div>
            <div class="room_information_amenities">

            </div>
        </div>
        <div class="room_pricing">
            here will be flying block for pricing... i love flying block!!! (why must i suffer)
        </div>
    </div>
    <div style="height: 5000px;">
        
    </div>
</div>
